{
  "scripts": {
    "build:scss": "sass assets/css/styles.scss assets/css/styles.css --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions",
    "watch:scss": "sass -w assets/css/styles.scss assets/css/styles.css --no-source-map --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "font-awesome": "^4.7.0",
    "primeicons": "^7.0.0",
    "sass": "^1.89.0"
  }
}
